# URL base del servidor de medios (MinIO, S3, etc.)
# En desarrollo apunta a localhost:9000
# En producción cambia por la URL pública de tu servidor de imágenes
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000

# URL base de la API (opcional, para entornos externos)
# Dejar vacío para usar la API interna de Next.js (/api/query)
NEXT_PUBLIC_API_BASE_URL=
